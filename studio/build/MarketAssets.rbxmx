ool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="Part" referent="RBXd0b63a26b11444a38d5e575347bdab7c"><Properties><string name="Name">StandingFootboard</string><Vector3 name="size"><X>1.65</X><Y>0.25</Y><Z>2.6</Z></Vector3><CoordinateFrame name="CFrame"><X>4.65</X><Y>2.8</Y><Z>6</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4284630061</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="Part" referent="RBX1758d18ddfcf483ab9c1919dfe8524fb"><Properties><string name="Name">SideGrabHandle</string><Vector3 name="size"><X>0.2</X><Y>1.4500000000000002</Y><Z>0.2</Z></Vector3><CoordinateFrame name="CFrame"><X>4.28</X><Y>6.425000000000001</Y><Z>5.25</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4283519305</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="Part" referent="RBXf32100b49fdf42aebbdbf43a77395304"><Properties><string name="Name">HandleMount</string><Vector3 name="size"><X>0.16</X><Y>0.33000000000000007</Y><Z>0.16</Z></Vector3><CoordinateFrame name="CFrame"><X>4.115</X><Y>5.7</Y><Z>5.25</Z><R00>0.0</R00><R01>1.0</R01><R02>-0.0</R02><R10>-1.0</R10><R11>0.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4283519305</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="Part" referent="RBX113e44bd5da94a4595bbe96ab6822df7"><Properties><string name="Name">SideGrabHandle</string><Vector3 name="size"><X>0.2</X><Y>1.4500000000000002</Y><Z>0.2</Z></Vector3><CoordinateFrame name="CFrame"><X>4.28</X><Y>6.425000000000001</Y><Z>6.75</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4283519305</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="Part" referent="RBX3437fdad21e74b4f886c641905f0cd6c"><Properties><string name="Name">HandleMount</string><Vector3 name="size"><X>0.16</X><Y>0.33000000000000007</Y><Z>0.16</Z></Vector3><CoordinateFrame name="CFrame"><X>4.115</X><Y>5.7</Y><Z>6.75</Z><R00>0.0</R00><R01>1.0</R01><R02>-0.0</R02><R10>-1.0</R10><R11>0.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4283519305</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="Part" referent="RBX4baa675670fd4b40a4ddc9d8c9a10173"><Properties><string name="Name">DropShelf</string><Vector3 name="size"><X>2.1</X><Y>0.25</Y><Z>1.1</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>4.7</Y><Z>12</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4289821766</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Anchored">false</bool><bool name="Massless">true</bool></Properties></Item><Item class="RemoteEvent" referent="RBX816b3773a89745cfa1698a99e41283b3"><Properties><string name="Name">ReleaseHold</string></Properties></Item><Item class="Script" referent="RBXe0d900478f244e8ea6d3c266755c7316"><Properties><string name="Name">TruckRidersServer</string><ProtectedString name="Source">-- Four standing hold points; passenger Seats are handled by Roblox.
local truck = script.Parent
local Players = game:GetService('Players')
local release = truck:WaitForChild('ReleaseHold')
local occupied, riders = {}, {}
local function leave(player)
 local state = riders[player]
 if not state then return end
 riders[player] = nil; occupied[state.point] = nil
 if state.weld then state.weld:Destroy() end
 if state.death then state.death:Disconnect() end
 for _, object in state.ik do object:Destroy() end
 for joint, original in state.joints do
  if joint.Parent then joint.C0 = original end
 end
 local h = state.humanoid
 if h.Parent then
  h.PlatformStand = false; h.AutoRotate = state.autoRotate
  h:ChangeState(Enum.HumanoidStateType.GettingUp)
  local root = h.Parent:FindFirstChild('HumanoidRootPart')
  if root then
   local exit = state.point.CFrame * CFrame.new(0, 3, 3)
   root.CFrame = exit
   root.AssemblyLinearVelocity = truck.Chassis.AssemblyLinearVelocity
  end
 end
 player:SetAttribute('HoldingSeedTruck', false)
 state.prompt.ActionText = 'Hold on'
end
for _, point in truck.HoldPoints:GetChildren() do
 local prompt = point:FindFirstChildOfClass('ProximityPrompt')
 prompt.Triggered:Connect(function(player)
  if riders[player] then leave(player); return end
  if occupied[point] then return end
  local char = player.Character
  local h = char and char:FindFirstChildOfClass('Humanoid')
  local root = char and char:FindFirstChild('HumanoidRootPart')
  if not h or not root or h.Health &lt;= 0 or h.SeatPart then return end
  if (root.Position-point.Position).Magnitude &gt; 11 then return end
  local state = {point=point, prompt=prompt, humanoid=h, autoRotate=h.AutoRotate, joints={}, ik={}}
  occupied[point] = player; riders[player] = state
  h.AutoRotate = false; h.PlatformStand = true
  root.CFrame = point.CFrame * CFrame.new(0, 3.1, 0)
  for _, side in {'Left', 'Right'} do
   local arm, hand = char:FindFirstChild(side..'UpperArm'), char:FindFirstChild(side..'Hand')
   if arm and hand then
    local target=Instance.new('Attachment')
    target.Name=side..'HandTarget'; target.Position=Vector3.new(side=='Left' and -.75 or .75,3.6,-.57);target.Parent=point
    local ik=Instance.new('IKControl');ik.Name='TruckGrip'..side;ik.Type=Enum.IKControlType.Position
    ik.ChainRoot=arm;ik.EndEffector=hand;ik.Target=target;ik.Weight=1;ik.SmoothTime=0;ik.Parent=h
    table.insert(state.ik,ik);table.insert(state.ik,target)
   end
  end
  for _, joint in char:GetDescendants() do
   if h.RigType==Enum.HumanoidRigType.R6 and joint:IsA('Motor6D') and (joint.Name=='Left Shoulder' or joint.Name=='Right Shoulder') then
    state.joints[joint] = joint.C0
    joint.C0 = joint.C0 * CFrame.Angles(math.rad(85), 0, 0)
   end
  end
  local weld = Instance.new('WeldConstraint')
  weld.Name='StandingRider'; weld.Part0=point; weld.Part1=root; weld.Parent=point; state.weld=weld
  state.death=h.Died:Connect(function() leave(player) end)
  player:SetAttribute('HoldingSeedTruck',true)
  prompt.ActionText='Let go'
 end)
end
release.OnServerEvent:Connect(leave)
Players.PlayerRemoving:Connect(leave)
</ProtectedString><token name="RunContext">1</token></Properties></Item><Item class="Script" referent="RBXfb357714e4fd41abaf576bcfe4e0f556"><Properties><string name="Name">TruckRidersClient</string><ProtectedString name="Source">-- Jump releases a standing hold, including the mobile jump button.
local player=game:GetService('Players').LocalPlayer
local input=game:GetService('UserInputService')
local remote=script.Parent:WaitForChild('ReleaseHold')
input.JumpRequest:Connect(function()
 if player:GetAttribute('HoldingSeedTruck') then remote:FireServer() end
end)
</ProtectedString><token name="RunContext">2</token></Properties></Item></Item></Item><SharedStrings>
